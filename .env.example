# Auto Job Hunter - 环境配置模板
# 复制此文件为 .env 并填入实际值

# 应用配置
APP_NAME=Auto Job Hunter
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# 数据库配置
DATABASE_URL=sqlite:///./auto_job_hunter.db
# 生产环境使用PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/auto_job_hunter

# Redis配置 (可选，用于缓存和任务队列)
REDIS_URL=redis://localhost:6379/0

# AI模型配置
# OpenAI配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# 本地模型配置 (使用Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# 平台配置
# BOSS直聘
BOSS_USERNAME=your_boss_username
BOSS_PASSWORD=your_boss_password

# 猎聘
LIEPIN_USERNAME=your_liepin_username
LIEPIN_PASSWORD=your_liepin_password

# 脉脉
MAIMAI_USERNAME=your_maimai_username
MAIMAI_PASSWORD=your_maimai_password

# 安全配置
SECRET_KEY=your_secret_key_here_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 任务调度配置
SCHEDULER_ENABLED=true
MAX_CONCURRENT_JOBS=5

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/auto_job_hunter.log

# 通知配置 (可选)
# 邮件通知
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# Webhook通知
WEBHOOK_URL=https://your-webhook-url.com